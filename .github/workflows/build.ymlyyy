name: Build release APK (unsigned)

on:
  push:
    branches: [main, master]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # Works whether you uploaded the unzipped files OR the .zip itself.
      - name: Unpack project zip if needed
        run: |
          if [ ! -f settings.gradle.kts ]; then
            ZIP=$(ls ./*.zip 2>/dev/null | head -n1)
            [ -n "$ZIP" ] || { echo "No project files and no .zip found in repo root"; exit 1; }
            unzip -q "$ZIP" -d _unz
            DIR=$(dirname "$(find _unz -name settings.gradle.kts | head -n1)")
            cp -a "$DIR"/. .
          fi
          ls -a

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Fetch fonts (Space Mono / Space Grotesk, OFL)
        run: |
          mkdir -p app/src/main/assets/fonts
          curl -fsSL -o app/src/main/assets/fonts/SpaceMono-Regular.ttf \
            "https://github.com/google/fonts/raw/main/ofl/spacemono/SpaceMono-Regular.ttf" || echo "SpaceMono download failed"
          curl -fsSL -o app/src/main/assets/fonts/SpaceGrotesk.ttf \
            "https://github.com/google/fonts/raw/main/ofl/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf" || echo "SpaceGrotesk download failed"

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      - name: Build release APK
        run: gradle assembleRelease --stacktrace

      - name: Rename APK
        run: cp app/build/outputs/apk/release/app-release-unsigned.apk GlyphTV-release-unsigned.apk

      - uses: actions/upload-artifact@v4
        with:
          name: GlyphTV-release-unsigned
          path: GlyphTV-release-unsigned.apk

      - name: Attach to GitHub Release (tags v*)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: GlyphTV-release-unsigned.apk
